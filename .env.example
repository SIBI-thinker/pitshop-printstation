# Name shown on the phone site and counter screen
SHOP_NAME=Print Station

# --- Wi-Fi hotspot (Windows Mobile Hotspot) ---
HOTSPOT_SSID=PrintStation
HOTSPOT_PASSWORD=PrintNow2024
# Address of the laptop on its own hotspot (Windows uses 192.168.137.1)
HOTSPOT_GATEWAY=192.168.137.1
# Turn the hotspot on when the server starts
HOTSPOT_AUTOSTART=true
# Open the print page automatically after a phone joins the Wi-Fi (needs scripts/captive-hosts.js once)
CAPTIVE_PORTAL=true

# --- Server ---
# Keep 80: phones only open the page automatically on port 80
SERVER_PORT=80

# --- Limits (keep these small on a low-spec laptop) ---
MAX_UPLOAD_MB=20
MAX_FILES_PER_ORDER=10
MAX_PAGES_PER_ORDER=300
# Customers at once (filling in an order or holding a PIN); any of them can be served in any order
MAX_ACTIVE_ORDERS=10
MAX_ORDERS_PER_DEVICE=3
MAX_COPIES=20
# Unconfirmed orders are deleted after this many idle minutes
DRAFT_TTL_MINUTES=30
# How long a PIN stays valid after the customer confirms
PIN_TTL_MINUTES=120
# Finished orders (and their files) are deleted after this
KEEP_DONE_MINUTES=15

# --- What the printer can do (hides options customers cannot use) ---
COLOR_PRINTING=true
DUPLEX_PRINTING=true
PAPER_SIZES=A4,A3,A5,Letter,Legal
# Accept Word, Excel and PowerPoint (conversion is slow on weak laptops)
ALLOW_OFFICE=true

# --- Printer and tools ---
# Leave blank to use the Windows default printer
PRINTER_NAME=
SUMATRA_PATH=C:\Program Files\SumatraPDF\SumatraPDF.exe
# Office to PDF: "interop" uses Microsoft Office, "libreoffice" uses LIBREOFFICE_PATH
CONVERSION_METHOD=interop
LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
